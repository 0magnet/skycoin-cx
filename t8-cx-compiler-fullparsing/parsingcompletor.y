/* %start                  translation_unit */
%%



translation_unit:
                external_declaration
        |       translation_unit external_declaration
        ;

external_declaration:
                package_declaration
        |       global_declaration
        |       function_declaration
        |       import_declaration
        |       struct_declaration

        |       debugging
        ;

debugging:      
                DPROGRAM
                {
			astbuild.AST.ProgramPrint()
                }
        ;

//delete selector, but cannot because goyacc segfaults
selector:
                IMPORT STRING_LITERAL IDENTIFIER
                {
                //
                }
                ;

// A var declaration declares one or more names, or a parenthesized group of
// such specs, as in Go (https://go.dev/ref/spec#Variable_declarations).
global_declaration:
                VAR global_var_spec SEMICOLON
        |       VAR LPAREN global_var_specs RPAREN SEMICOLON
        |       VAR LPAREN RPAREN SEMICOLON
                ;

global_var_specs:
                global_var_spec
        |       global_var_specs SEMICOLON global_var_spec
        |       global_var_specs SEMICOLON
                ;

global_var_spec:
                var_names declaration_specifiers
                {
			astbuild.GlobalsDeclare(astbuild.AST, $1, $2, nil, nil, false)
                }
        |       var_names declaration_specifiers ASSIGN assignment_value_list
                {
			astbuild.GlobalsDeclare(astbuild.AST, $1, $2, $4, nil, true)
                }
        |       var_names ASSIGN assignment_value_list
                {
			astbuild.GlobalsDeclare(astbuild.AST, $1, nil, $3, nil, true)
                }
                ;

var_names:
                declarator
                {
			$$ = []*ast.CXArgument{$1}
                }
        |       var_names COMMA declarator
                {
			$$ = append($1, $3)
                }
                ;

struct_declaration:
                TYPE IDENTIFIER STRUCT struct_fields
                {
		        astbuild.StructDeclare(astbuild.AST,$2, $4, astbuild.CurrentFile, $<line>2, $<column>2)
                }
                ;

// A semicolon may be omitted before the closing brace, as in Go, so a struct
// fits on one line: type T struct { a i32; b i32 }.
struct_fields:
                LBRACE RBRACE SEMICOLON
                { $$ = nil }
        |       LBRACE fields RBRACE SEMICOLON
                { $$ = $2 }
        |       LBRACE fields SEMICOLON RBRACE SEMICOLON
                { $$ = $2 }
        ;

fields:         parameter_declaration
                {
			// OBJMODEL: state.CXArgumentMng (manager storage) or []CXArgumentGid, phase 4 #326.
			// Now a slice of objects, site S1474.
			$$ = []*ast.CXArgument{$1}
                }
        |       fields SEMICOLON parameter_declaration
                {
			$$ = append($1, $3)
                }
        ;

package_declaration:
                PACKAGE IDENTIFIER SEMICOLON
                {
			astbuild.PackageDeclare(astbuild.AST,$2)
                }
                ;

import_declaration:
                IMPORT STRING_LITERAL SEMICOLON
                {
			// ImportDeclare($2)
                }
        // The imports into scope of #487, which pass one declares.
        |       IMPORT PERIOD STRING_LITERAL SEMICOLON
        |       IMPORT IDENTIFIER PERIOD STRING_LITERAL SEMICOLON
        |       IMPORT LPAREN import_names RPAREN STRING_LITERAL SEMICOLON
        |       IMPORT IDENTIFIER LPAREN import_names RPAREN STRING_LITERAL SEMICOLON
        ;

import_names:
                IDENTIFIER
        |       import_names COMMA IDENTIFIER
        ;

function_header:
                FUNC IDENTIFIER
                {
			// yylval.line = 0
			$$ = astbuild.FunctionHeader(astbuild.AST,$2, nil, false, $<line>2, $<column>2)
			astbuild.ScopeGlobalsBegin($$)
                }
        |       FUNC LPAREN parameter_type_list RPAREN IDENTIFIER
                {
			$$ = astbuild.FunctionHeader(astbuild.AST,$5, $3, true, $<line>5, $<column>5)
			astbuild.ScopeGlobalsBegin($$)
			astbuild.ImportScopedLocalsDeclare(astbuild.AST, $3)
                }
        ;

function_parameters:
                LPAREN RPAREN
                { $$ = nil }
        |       LPAREN parameter_type_list RPAREN
                { $$ = $2; astbuild.ImportScopedLocalsDeclare(astbuild.AST, $2) }
                ;

// A result list holds names and valuetypes, (r i32, s str), or only valuetypes,
// (i32, str), as in Go. Unnamed results get hidden names.
function_results:
                function_parameters
        |       LPAREN result_type_list RPAREN
                {
			$$ = astbuild.FunctionResultsUnnamed(astbuild.AST, $2)
                }
        |       LPAREN result_type_list COMMA RPAREN
                {
			$$ = astbuild.FunctionResultsUnnamed(astbuild.AST, $2)
                }
        ;

result_type_list:
                declaration_specifiers
                {
			$$ = []*ast.CXArgument{$1}
                }
        |       result_type_list COMMA declaration_specifiers
                {
			$$ = append($1, $3)
                }
        ;

function_declaration:
                function_header function_parameters compound_statement SEMICOLON
                {
			astbuild.FunctionDeclaration(astbuild.AST,$1, $2, nil, $3)
                }
        |       function_header function_parameters function_results compound_statement SEMICOLON
                {
			astbuild.FunctionDeclaration(astbuild.AST,$1, $2, $3, $4)
                }
        |       function_header function_parameters declaration_specifiers compound_statement SEMICOLON
                {
			astbuild.FunctionDeclaration(astbuild.AST,$1, $2, astbuild.FunctionResultUnnamed(astbuild.AST, $3), $4)
                }
        ;

// Parameters, arguments and results may end in a comma too.
parameter_type_list:
		parameter_list
	|	parameter_list COMMA
                ;

parameter_list:
                parameter_declaration
                {
			// OBJMODEL: state.CXArgumentMng (manager storage) or []CXArgumentGid, phase 4 #326.
			// Now a slice of objects, site S1475.
			$$ = []*ast.CXArgument{$1}
                }
	|       parameter_list COMMA parameter_declaration
                {
			$$ = append($1, $3)
                }
                ;

parameter_declaration:
                declarator declaration_specifiers
                {
			$2.Name = $1.Name
			$2.Package = $1.Package
			// The errors of a parameter point at its name, see #486.
			nameDetails := astbuild.AST.CxIrState.CXArgumentDebugMng.CXArgumentDebugGet($1.ArgDetails)
			typeDetails := astbuild.AST.CxIrState.CXArgumentDebugMng.CXArgumentDebugGet($2.ArgDetails)
			typeDetails.FileName, typeDetails.FileLine, typeDetails.FileColumn = nameDetails.FileName, nameDetails.FileLine, nameDetails.FileColumn
			astbuild.AST.CXArgBuilderRelease($1)

			$$ = $2
                }
                ;

declarator:     direct_declarator
                ;

direct_declarator:
                IDENTIFIER
                {
			if pkg, err := astbuild.AST.CurrentPackageGet(); err == nil {
				_, arg := ast.ArgumentMake(astbuild.AST, stringpool.StringGidNil, astbuild.CurrentFile, astbuild.LineNo)
				arg.TypeSet(valuetypes.UNDEFINED)
				arg.Name = astbuild.AST.CXProgramNameIntern($1)
				astbuild.AST.CxIrState.CXArgumentDebugMng.CXArgumentDebugGet(arg.ArgDetails).FileColumn = $<column>1
				arg.Package = ast.CXPackageIndex(pkg.Index)
				$$ = arg
			} else {
				panic(err)
			}
                }
	|       LPAREN declarator RPAREN
                { $$ = $2 }
                ;

id_list:	IDENTIFIER
		{
			arg := astbuild.DeclarationSpecifiersStruct(astbuild.AST,$1, "", false, astbuild.CurrentFile, $<line>1, $<column>1)
			// OBJMODEL: state.CXArgumentMng (manager storage) or []CXArgumentGid, phase 4 #326.
			// Now a slice of objects, site S1477.
			$$ = []*ast.CXArgument{arg}
		}
	|	type_specifier
		{
			arg := astbuild.DeclarationSpecifiersBasic(astbuild.AST, valuetypes.Code($1))
			// OBJMODEL: state.CXArgumentMng (manager storage) or []CXArgumentGid, phase 4 #326.
			// Now a slice of objects, site S1478.
			$$ = []*ast.CXArgument{arg}
		}
	|	id_list COMMA IDENTIFIER
		{
			arg := astbuild.DeclarationSpecifiersStruct(astbuild.AST,$3, "", false, astbuild.CurrentFile, $<line>3, $<column>3)
			$$ = append($1, arg)
		}
	|	id_list COMMA type_specifier
		{
			arg := astbuild.DeclarationSpecifiersBasic(astbuild.AST, valuetypes.Code($3))
			$$ = append($1, arg)
		}
	;



types_list:

		LPAREN id_list RPAREN

		{

			$$ = $2

		}
	|	LPAREN RPAREN
		{
			$$ = nil
		}
	;

declaration_specifiers:
                element_specifiers
        |       indexing_literal array_element
                {
			$$ = astbuild.DeclarationSpecifiers($2, valuetypes.SintToSptrCast($1), opcodetable.DeclarationArray)
                }
                ;

element_specifiers:
                FUNC types_list types_list
		{
			_, arg := ast.ArgumentMake(astbuild.AST, stringpool.StringGidNil, astbuild.CurrentFile, astbuild.LineNo)
			arg.TypeSet(valuetypes.FUNC)
                       
			// OBJMODEL: state.CXArgumentMng.CXArgumentAlloc(), phase 4 #326.
			// Now an arena insert, site S1480.
			arg.Inputs =  astbuild.AST.PointerArgsToCXArgsArrayAdd($2)
			// OBJMODEL: state.CXArgumentMng.CXArgumentAlloc(), phase 4 #326.
			// Now an arena insert, site S1481.
			arg.Outputs =  astbuild.AST.PointerArgsToCXArgsArrayAdd($3)
			$$ = astbuild.DeclarationSpecifiers(arg, []valuetypes.Pointer{0}, opcodetable.DeclarationFunc)
		}
        |       MUL_OP declaration_specifiers
                {
			$$ = astbuild.DeclarationSpecifiers($2, []valuetypes.Pointer{0}, opcodetable.DeclarationPointer)
                }
        |       LBRACK RBRACK declaration_specifiers
                {
			$$ = astbuild.DeclarationSpecifiers($3, []valuetypes.Pointer{0}, opcodetable.DeclarationSlice)
                }
        |       type_specifier
                {
			$$ = astbuild.DeclarationSpecifiersBasic(astbuild.AST, valuetypes.Code($1))
                }
        |       IDENTIFIER
                {
			$$ = astbuild.DeclarationSpecifiersStruct(astbuild.AST,$1, "", false, astbuild.CurrentFile, $<line>1, $<column>1)
                }
        |       IDENTIFIER PERIOD IDENTIFIER
                {
			$$ = astbuild.DeclarationSpecifiersStruct(astbuild.AST,$3, $1, true, astbuild.CurrentFile, $<line>1, $<column>1)
                }
	|       type_specifier PERIOD IDENTIFIER
                {
			$$ = astbuild.DeclarationSpecifiersStruct(astbuild.AST,$3, valuetypes.Code($1).Name(), true, astbuild.CurrentFile, $<line>1, $<column>1)
                }
                ;

// array_element is what an array may hold: a basic or struct type, a struct
// of another package, or a pointer to one of them.
array_element:
                type_specifier
                {
			$$ = astbuild.DeclarationSpecifiersBasic(astbuild.AST, valuetypes.Code($1))
                }
        |       IDENTIFIER
                {
			$$ = astbuild.DeclarationSpecifiersStruct(astbuild.AST,$1, "", false, astbuild.CurrentFile, $<line>1, $<column>1)
                }
        |       IDENTIFIER PERIOD IDENTIFIER
                {
			$$ = astbuild.DeclarationSpecifiersStruct(astbuild.AST,$3, $1, true, astbuild.CurrentFile, $<line>1, $<column>1)
                }
        |       type_specifier PERIOD IDENTIFIER
                {
			$$ = astbuild.DeclarationSpecifiersStruct(astbuild.AST,$3, valuetypes.Code($1).Name(), true, astbuild.CurrentFile, $<line>1, $<column>1)
                }
        |       MUL_OP declaration_specifiers
                {
			$$ = astbuild.DeclarationSpecifiers($2, []valuetypes.Pointer{0}, opcodetable.DeclarationPointer)
                }
        |       LBRACK RBRACK declaration_specifiers
                {
			$$ = astbuild.DeclarationSpecifiers($3, []valuetypes.Pointer{0}, opcodetable.DeclarationSlice)
                }
                ;

type_specifier:
                AFF
                { $$ = int(valuetypes.AFF) }
        |       BOOL
                { $$ = int(valuetypes.BOOL) }
        |       STR
                { $$ = int(valuetypes.STR) }
        |       F32
                { $$ = int(valuetypes.F32) }
        |       F64
                { $$ = int(valuetypes.F64) }
        |       I8
                { $$ = int(valuetypes.I8) }
        |       I16
                { $$ = int(valuetypes.I16) }
        |       I32
                { $$ = int(valuetypes.I32) }
        |       I64
                { $$ = int(valuetypes.I64) }
        |       UI8
                { $$ = int(valuetypes.UI8) }
        |       UI16
                { $$ = int(valuetypes.UI16) }
        |       UI32
                { $$ = int(valuetypes.UI32) }
        |       UI64
                { $$ = int(valuetypes.UI64) }
                ;


struct_literal_fields:
                // empty
                { $$ = nil }
        |       IDENTIFIER COLON conditional_expression
                {
                        $$ = astbuild.StructLiteralField(astbuild.AST, $1, $<line>1, $<column>1, $3)
                }
        |       struct_literal_fields COMMA IDENTIFIER COLON conditional_expression
                {
                        $$ = append($1, astbuild.StructLiteralField(astbuild.AST, $3, $<line>3, $<column>3, $5)...)
                }
                ;

literal_element_list:
                literal_element
        |       literal_element_list COMMA literal_element
                {
			$$ = append($1, $3...)
                }
                ;

// A list of elements or fields may end in a comma, which Go requires when the
// closing brace is on the next line (https://go.dev/ref/spec#Semicolons).
list_end:
                RBRACE
                { $$ = false }
        |       COMMA RBRACE
                { $$ = true }
                ;

// An elided element, {1, 2} or {x: 1}, takes the element type of its literal.
literal_element:
                assignment_expression
                {
			$$ = []astbuild.LiteralElement{{Expressions: $1, Line: $<line>1, Column: $<column>1}}
                }
        |       LBRACE literal_element_list list_end
                {
			$$ = []astbuild.LiteralElement{{Elements: $2, Elided: true, Line: astbuild.LineNo}}
                }
        |       LBRACE struct_literal_fields list_end
                {
			ParserActionStructLiteralComma($2, $3)
			$$ = []astbuild.LiteralElement{{Fields: $2, Elided: true, Keyed: true, Line: astbuild.LineNo}}
                }
                ;

indexing_literal:
		LBRACK INT_LITERAL RBRACK
		{
			$$ = []int{int($2)}
		}
        |       indexing_literal LBRACK INT_LITERAL RBRACK
		{
			$$ = append($1, int($3))
		}
		;

indexing_slice_literal:
		LBRACK RBRACK
		{
			$$ = []int{0}
		}
        |       indexing_slice_literal LBRACK RBRACK
		{
			$$ = append($1, 0)
		}
		;

// expressions
array_literal_expression:
                indexing_literal IDENTIFIER LBRACE literal_element_list list_end
                {
			lengths := valuetypes.SintToSptrCast($1)
			elements := astbuild.LiteralElementsFlatten(astbuild.AST, astbuild.LiteralType{Lengths: lengths, StructName: $2, Line: $<line>1, Column: $<column>1}, $4)
			$$ = astbuild.ArrayLiteralStructExpression(astbuild.AST, lengths, $2, $<line>1, $<column>1, elements)
                }
        |       indexing_literal IDENTIFIER LBRACE RBRACE
                {
			$$ = astbuild.ArrayLiteralStructExpression(astbuild.AST, valuetypes.SintToSptrCast($1), $2, $<line>1, $<column>1, nil)
                }
        |       indexing_literal type_specifier LBRACE literal_element_list list_end
                {
			lengths := valuetypes.SintToSptrCast($1)
			elements := astbuild.LiteralElementsFlatten(astbuild.AST, astbuild.LiteralType{Lengths: lengths, TypeCode: valuetypes.Code($2)}, $4)
			$$ = astbuild.ArrayLiteralExpression(astbuild.AST, lengths, valuetypes.Code($2), $<line>1, $<column>1, elements)
                }
        |       indexing_literal type_specifier LBRACE RBRACE
                {
			$$ = astbuild.ArrayLiteralExpression(astbuild.AST, valuetypes.SintToSptrCast($1), valuetypes.Code($2), $<line>1, $<column>1, nil)
                }
                ;

slice_literal_expression:
                indexing_slice_literal IDENTIFIER LBRACE literal_element_list list_end
                {
			typ := astbuild.LiteralType{Lengths: valuetypes.SintToSptrCast($1), Slice: true, StructName: $2, Line: $<line>1, Column: $<column>1}
			$$ = astbuild.LiteralSlice(astbuild.AST, typ, astbuild.LiteralElementsFlatten(astbuild.AST, typ, $4))
                }
        |       indexing_slice_literal IDENTIFIER LBRACE RBRACE
                {
			$$ = astbuild.LiteralSlice(astbuild.AST, astbuild.LiteralType{Lengths: valuetypes.SintToSptrCast($1), Slice: true, StructName: $2, Line: $<line>1, Column: $<column>1}, nil)
                }
        |       indexing_slice_literal type_specifier LBRACE literal_element_list list_end
                {
			typ := astbuild.LiteralType{Lengths: valuetypes.SintToSptrCast($1), Slice: true, TypeCode: valuetypes.Code($2)}
			$$ = astbuild.LiteralSlice(astbuild.AST, typ, astbuild.LiteralElementsFlatten(astbuild.AST, typ, $4))
                }
        |       indexing_slice_literal type_specifier LBRACE RBRACE
                {
			$$ = astbuild.LiteralSlice(astbuild.AST, astbuild.LiteralType{Lengths: valuetypes.SintToSptrCast($1), Slice: true, TypeCode: valuetypes.Code($2)}, nil)
                }
                ;

// A literal of a type with a pointer or with both array and slice
// dimensions, such as []*T or [2][]i32.
compound_literal_type:
                indexing_literal MUL_OP declaration_specifiers
                {
			$$ = astbuild.DeclarationSpecifiers(astbuild.DeclarationSpecifiers($3, []valuetypes.Pointer{0}, opcodetable.DeclarationPointer), valuetypes.SintToSptrCast($1), opcodetable.DeclarationArray)
                }
        |       indexing_literal LBRACK RBRACK declaration_specifiers
                {
			$$ = astbuild.DeclarationSpecifiers(astbuild.DeclarationSpecifiers($4, []valuetypes.Pointer{0}, opcodetable.DeclarationSlice), valuetypes.SintToSptrCast($1), opcodetable.DeclarationArray)
                }
        |       indexing_slice_literal MUL_OP declaration_specifiers
                {
			$$ = astbuild.LiteralTypeSlices(astbuild.DeclarationSpecifiers($3, []valuetypes.Pointer{0}, opcodetable.DeclarationPointer), len($1))
                }
        |       indexing_slice_literal indexing_literal array_element
                {
			$$ = astbuild.LiteralTypeSlices(astbuild.DeclarationSpecifiers($3, valuetypes.SintToSptrCast($2), opcodetable.DeclarationArray), len($1))
                }
                ;

compound_literal_expression:
                compound_literal_type LBRACE literal_element_list list_end
                {
			$$ = astbuild.LiteralCompound(astbuild.AST, $1, $<line>1, $<column>1, $3)
                }
        |       compound_literal_type LBRACE RBRACE
                {
			$$ = astbuild.LiteralCompound(astbuild.AST, $1, $<line>1, $<column>1, nil)
                }
                ;
affordance_clause:
                IDENTIFIER LPAREN IDENTIFIER RPAREN
                {
			$$ = astbuild.AffordanceClauseParsed{AffordanceClauseParsedName: $1, AffordanceClauseParsedArgument: $3, AffordanceClauseParsedLine: $<line>1, AffordanceClauseParsedColumn: $<column>1}
                }
        |       VAR LPAREN IDENTIFIER RPAREN
                {
			$$ = astbuild.AffordanceClauseParsed{AffordanceClauseParsedName: "var", AffordanceClauseParsedArgument: $3, AffordanceClauseParsedLine: $<line>1, AffordanceClauseParsedColumn: $<column>1}
                }
        ;

affordance_clauses:
                {
			$$ = nil
                }
        |       affordance_clauses affordance_clause
                {
			$$ = append($1, $2)
                }
        |       affordance_clauses SEMICOLON
                {
			$$ = $1
                }
        ;

primary_expression:
                IDENTIFIER
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryIdentifier(astbuild.AST,$1)
			astbuild.TokenPositionPop(position)
                }
	|	FUNC LPAREN RPAREN
		{
			$$ = nil
		}
        |       INFER LBRACE affordance_clauses RBRACE
                {
			$$ = astbuild.AffordanceLiteral(astbuild.AST, $3, $<line>1)
                }
        |       STRING_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.STR, valuetypes.ObjectMake([]byte($1)), false)
			astbuild.TokenPositionPop(position)
                }
        |       BOOLEAN_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			exprs := astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.BOOL, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
			$$ = exprs
                }
        |       BYTE_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.I8, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
                }
        |       SHORT_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.I16, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
                }
        |       INT_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.I32, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
                }
        |       LONG_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.I64, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
                }
        |       UNSIGNED_BYTE_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.UI8, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
                }
        |       UNSIGNED_SHORT_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.UI16, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
                }
        |       UNSIGNED_INT_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.UI32, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
                }
        |       UNSIGNED_LONG_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.UI64, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
                }
        |       FLOAT_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.F32, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
                }
        |       DOUBLE_LITERAL
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST,valuetypes.F64, encoder.Serialize($1), false)
			astbuild.TokenPositionPop(position)
                }
        |       LPAREN expression RPAREN
                { $$ = $2 }
        |       array_literal_expression
                {
			$$ = $1
                }
        |       slice_literal_expression
                {
			$$ = $1
                }
        |       compound_literal_expression
                ;

after_period:   type_specifier
                {
			$$ = valuetypes.Code($1).Name()
                }
        |       IDENTIFIER
        ;

// A struct literal is an operand, as in Go, so T{a: 1}.m() + 1 parses. An
// if or for header uses the _nc rules below, which hold no bare struct
// literal, so `if x {` opens the body (skycoin-cx#21).
postfix_expression:
		primary_expression
	|       struct_literal_value
	|       postfix_expression LBRACK assignment_expression RBRACK
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PostfixExpressionArray(astbuild.AST,$1, $3)
			astbuild.TokenPositionPop(position)
                }
        |       type_specifier PERIOD after_period
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PostfixExpressionNative(astbuild.AST,valuetypes.Code($1), $3)
			astbuild.TokenPositionPop(position)
                }
	|       postfix_expression LPAREN RPAREN
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PostfixExpressionEmptyFunCall(astbuild.AST,$1)
			astbuild.TokenPositionPop(position)
                }
	|       postfix_expression LPAREN argument_expression_list RPAREN
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PostfixExpressionFunCall(astbuild.AST,$1, $3)
			astbuild.TokenPositionPop(position)
                }
	|       postfix_expression LPAREN argument_expression_list COMMA RPAREN
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PostfixExpressionFunCall(astbuild.AST,$1, $3)
			astbuild.TokenPositionPop(position)
                }
        |       postfix_expression PERIOD IDENTIFIER
                {
			position := astbuild.TokenPositionPush($<line>3, $<column>3)
			$$ = astbuild.PostfixExpressionField(astbuild.AST,$1, $3)
			astbuild.TokenPositionPop(position)
                }
                ;

struct_literal_value:
		IDENTIFIER LBRACE struct_literal_fields list_end
                {
			ParserActionStructLiteralComma($3, $4)
			$$ = astbuild.PrimaryStructLiteral(astbuild.AST, $1, $<line>1, $<column>1, $3)
                }
        |       postfix_expression PERIOD IDENTIFIER LBRACE struct_literal_fields list_end
                {
			ParserActionStructLiteralComma($5, $6)
			$$ = astbuild.PrimaryStructLiteralExternalOf(astbuild.AST, $1, $3, $<line>3, $<column>3, $5)
                }
                ;

argument_expression_list:
                assignment_expression
                {
			$$ = [][]ast.CXExpression{$1}
                }
	|       argument_expression_list COMMA assignment_expression
                {
			$$ = append($1, $3)
                }
                ;

unary_expression:
                postfix_expression
                {
			$$ = astbuild.MethodCallValue(astbuild.AST, $1)
                }
	|       unary_operator unary_expression
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.UnaryExpression(astbuild.AST,$1, $2)
			astbuild.TokenPositionPop(position)
                }
                ;

unary_operator:
                REF_OP
	|       MUL_OP
	|       ADD_OP
	|       SUB_OP
	|       NEG_OP
                ;

// Binary operator precedence follows https://go.dev/ref/spec#Operator_precedence
multiplicative_expression:
                unary_expression
        |       multiplicative_expression MUL_OP unary_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpMul)
                }
        |       multiplicative_expression DIV_OP unary_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpDiv)
                }
        |       multiplicative_expression MOD_OP unary_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpMod)
                }
        |       multiplicative_expression LEFT_OP unary_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitshl)
                }
        |       multiplicative_expression RIGHT_OP unary_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitshr)
                }
        |       multiplicative_expression REF_OP unary_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitand)
                }
        |       multiplicative_expression BITCLEAR_OP unary_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitclear)
                }
                ;

additive_expression:
                multiplicative_expression
        |       additive_expression ADD_OP multiplicative_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpAdd)
                }
	|       additive_expression SUB_OP multiplicative_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpSub)
                }
        |       additive_expression BITOR_OP multiplicative_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitor)
                }
        |       additive_expression BITXOR_OP multiplicative_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitxor)
                }
                ;

relational_expression:
                additive_expression
        |       relational_expression EQ_OP additive_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpEqual)
                }
        |       relational_expression NE_OP additive_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpUnequal)
                }
        |       relational_expression LT_OP additive_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpLt)
                }
        |       relational_expression GT_OP additive_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpGt)
                }
        |       relational_expression LTEQ_OP additive_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpLteq)
                }
        |       relational_expression GTEQ_OP additive_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpGteq)
                }
                ;

logical_and_expression:
                relational_expression
	|       logical_and_expression AND_OP relational_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBoolAnd)
                }
                ;

logical_or_expression:
                logical_and_expression
	|       logical_or_expression OR_OP logical_and_expression
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBoolOr)
                }
                ;

conditional_expression:
                logical_or_expression
	|       logical_or_expression '?' expression COLON conditional_expression
                ;

// The expression rules of an if or for header, which hold no bare struct
// literal. One in parentheses, brackets or braces is a full expression.
postfix_nc:
		primary_expression
	|       postfix_nc LBRACK assignment_expression RBRACK
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PostfixExpressionArray(astbuild.AST,$1, $3)
			astbuild.TokenPositionPop(position)
                }
        |       type_specifier PERIOD after_period
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PostfixExpressionNative(astbuild.AST,valuetypes.Code($1), $3)
			astbuild.TokenPositionPop(position)
                }
	|       postfix_nc LPAREN RPAREN
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PostfixExpressionEmptyFunCall(astbuild.AST,$1)
			astbuild.TokenPositionPop(position)
                }
	|       postfix_nc LPAREN argument_expression_list RPAREN
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PostfixExpressionFunCall(astbuild.AST,$1, $3)
			astbuild.TokenPositionPop(position)
                }
	|       postfix_nc LPAREN argument_expression_list COMMA RPAREN
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.PostfixExpressionFunCall(astbuild.AST,$1, $3)
			astbuild.TokenPositionPop(position)
                }
        |       postfix_nc PERIOD IDENTIFIER
                {
			position := astbuild.TokenPositionPush($<line>3, $<column>3)
			$$ = astbuild.PostfixExpressionField(astbuild.AST,$1, $3)
			astbuild.TokenPositionPop(position)
                }
                ;

unary_nc:
                postfix_nc
                {
			$$ = astbuild.MethodCallValue(astbuild.AST, $1)
                }
	|       unary_operator unary_nc
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = astbuild.UnaryExpression(astbuild.AST,$1, $2)
			astbuild.TokenPositionPop(position)
                }
                ;

multiplicative_nc:
                unary_nc
        |       multiplicative_nc MUL_OP unary_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpMul)
                }
        |       multiplicative_nc DIV_OP unary_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpDiv)
                }
        |       multiplicative_nc MOD_OP unary_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpMod)
                }
        |       multiplicative_nc LEFT_OP unary_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitshl)
                }
        |       multiplicative_nc RIGHT_OP unary_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitshr)
                }
        |       multiplicative_nc REF_OP unary_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitand)
                }
        |       multiplicative_nc BITCLEAR_OP unary_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitclear)
                }
                ;

additive_nc:
                multiplicative_nc
        |       additive_nc ADD_OP multiplicative_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpAdd)
                }
	|       additive_nc SUB_OP multiplicative_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpSub)
                }
        |       additive_nc BITOR_OP multiplicative_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitor)
                }
        |       additive_nc BITXOR_OP multiplicative_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBitxor)
                }
                ;

relational_nc:
                additive_nc
        |       relational_nc EQ_OP additive_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpEqual)
                }
        |       relational_nc NE_OP additive_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpUnequal)
                }
        |       relational_nc LT_OP additive_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpLt)
                }
        |       relational_nc GT_OP additive_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpGt)
                }
        |       relational_nc LTEQ_OP additive_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpLteq)
                }
        |       relational_nc GTEQ_OP additive_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpGteq)
                }
                ;

logical_and_nc:
                relational_nc
	|       logical_and_nc AND_OP relational_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBoolAnd)
                }
                ;

logical_or_nc:
                logical_and_nc
	|       logical_or_nc OR_OP logical_and_nc
                {
			$$ = astbuild.OperatorExpression(astbuild.AST,$1, $3, opcodetable.OpBoolOr)
                }
                ;


conditional_nc:
                logical_or_nc
                ;

assignment_expression:
                conditional_expression
	|       unary_expression assignment_operator assignment_expression
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionAssignmentExpression($1, $2, $3)
			astbuild.TokenPositionPop(position)
                }
                ;

assignment_operator:
                ASSIGN
        |       CASSIGN
	|       MUL_ASSIGN
	|       DIV_ASSIGN
	|       MOD_ASSIGN
	|       ADD_ASSIGN
	|       SUB_ASSIGN
	|       LEFT_ASSIGN
	|       RIGHT_ASSIGN
	|       AND_ASSIGN
	|       XOR_ASSIGN
	|       OR_ASSIGN
                ;
expression:     assignment_expression
	|       assignment_target_list ASSIGN assignment_value_list
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionMultipleAssignment($1, $2, $3)
			astbuild.TokenPositionPop(position)
                }
	|       assignment_target_list CASSIGN assignment_value_list
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionMultipleAssignment($1, $2, $3)
			astbuild.TokenPositionPop(position)
                }
                ;

// a, b = x, y evaluates every value before it assigns any, as in Go.
assignment_target_list:
                conditional_expression COMMA conditional_expression
                {
			$$ = [][]ast.CXExpression{$1, $3}
                }
	|       assignment_target_list COMMA conditional_expression
                {
			$$ = append($1, $3)
                }
                ;

assignment_target_list_nc:
                conditional_nc COMMA conditional_nc
                {
			$$ = [][]ast.CXExpression{$1, $3}
                }
	|       assignment_target_list_nc COMMA conditional_nc
                {
			$$ = append($1, $3)
                }
                ;

assignment_value_list:
                conditional_expression
                {
			$$ = [][]ast.CXExpression{$1}
                }
	|       assignment_value_list COMMA conditional_expression
                {
			$$ = append($1, $3)
                }
                ;

for_assignment_value_list:
                conditional_nc
                {
			$$ = [][]ast.CXExpression{$1}
                }
	|       for_assignment_value_list COMMA conditional_nc
                {
			$$ = append($1, $3)
                }
                ;

constant_expression:
                conditional_expression
                ;

declaration:
                VAR local_var_spec
                {
			$$ = $2
                }
        |       VAR LPAREN local_var_specs RPAREN
                {
			$$ = $3
                }
        |       VAR LPAREN RPAREN
                {
			$$ = nil
                }
                ;

local_var_specs:
                local_var_spec
        |       local_var_specs SEMICOLON local_var_spec
                {
			$$ = append($1, $3...)
                }
        |       local_var_specs SEMICOLON
                ;

local_var_spec:
                var_names declaration_specifiers
                {
			$$ = ParserActionDeclareLocals($1, $2, nil, false)
                }
        |       var_names declaration_specifiers ASSIGN assignment_value_list
                {
			$$ = ParserActionDeclareLocals($1, $2, $4, true)
                }
        |       var_names ASSIGN assignment_value_list
                {
			$$ = ParserActionDeclareLocals($1, nil, $3, true)
                }
                ;

// statements
statement:      labeled_statement
	|       compound_statement
                {
			astbuild.DefineNewScope($1)
			$$ = $1
                }
	|       expression_statement
	|       selection_statement
	|       iteration_statement
        |       selector
        |       debugging
                { $$ = nil }
	|       jump_statement
                ;

labeled_statement:
                IDENTIFIER COLON block_item
                {
			$$ = ParserActionLabeledStatement($1, $3)
                }
	|       CASE constant_expression COLON statement
                { $$ = nil }
	|       DEFAULT COLON statement
                { $$ = nil }
                ;

compound_statement:
                LBRACE block_item_list RBRACE
                {
                    $$ = $2
                }
                ;

// Statements are separated by semicolons and a statement may be empty, as in
// Go, so the semicolon before a closing brace may be omitted:
// func f() i32 { return 1 } (https://go.dev/ref/spec#Semicolons).
block_item_list:
                block_item
	|       block_item_list SEMICOLON block_item
                {
			$$ = append($1, $3...)
                }
                ;

block_item:
                { $$ = nil }
        |       declaration
                {
			astbuild.ScopeGlobalsStatementSeen()
			$$ = $1
                }
        |       statement
                {
			astbuild.ScopeGlobalsStatementSeen()
			$$ = $1
                }
        // global names the globals the function uses, as its first
        // statements (#486). The lexer gives GLOBAL its brace depth.
        |       GLOBAL global_names
                {
			astbuild.ScopeGlobalsDeclare(astbuild.AST, $2, $<i>1, $<line>1, $<column>1)
			$$ = nil
                }
                ;

global_names:
                global_name
        |       global_names COMMA global_name
                {
			$$ = append($1, $3...)
                }
                ;

global_name:
                IDENTIFIER
                {
			$$ = []astbuild.ScopeGlobalName{{Name: astbuild.AST.CXProgramNameIntern($1), Line: $<line>1, Column: $<column>1}}
                }
        |       IDENTIFIER PERIOD IDENTIFIER
                {
			$$ = []astbuild.ScopeGlobalName{{Package: astbuild.AST.CXProgramNameIntern($1), Name: astbuild.AST.CXProgramNameIntern($3), Line: $<line>1, Column: $<column>1}}
                }
                ;

expression_statement:
                expression
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionExpressionStatement($1)
			astbuild.TokenPositionPop(position)
                }
	|       unary_expression INC_OP
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionExpressionStatement(astbuild.PostfixExpressionIncDec(astbuild.AST, $1, true))
			astbuild.TokenPositionPop(position)
                }
	|       unary_expression DEC_OP
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionExpressionStatement(astbuild.PostfixExpressionIncDec(astbuild.AST, $1, false))
			astbuild.TokenPositionPop(position)
                }
                ;

selection_statement:
                IF conditional_nc compound_statement elseif_list else_statement
                {
			$$ = astbuild.SelectionStatementCreate(astbuild.AST,$2, $3, $4, $5, astbuild.SelectionElseIfElse)
                }
        |       IF conditional_nc compound_statement else_statement
                {
			$$ = astbuild.SelectionExpressions(astbuild.AST,$2, $3, $4)
                }
        |       IF conditional_nc compound_statement elseif_list
                {
			$$ = astbuild.SelectionStatementCreate(astbuild.AST,$2, $3, $4, nil, astbuild.SelectionElseIf)
                }
        |       IF conditional_nc compound_statement
                {
			$$ = astbuild.SelectionExpressions(astbuild.AST,$2, $3, nil)
                }
	|       SWITCH LPAREN expression RPAREN statement
                { $$ = nil }
                ;

elseif:         ELSE IF conditional_nc compound_statement
                {
			$$ = astbuild.SelectStatement{
				Condition: $3,
				Then: $4,
			}
                }
                ;

elseif_list:    elseif
                {
			$$ = []astbuild.SelectStatement{$1}
                }
        |       elseif_list elseif
                {
			$$ = append($1, $2)
                }
        ;

else_statement:
                ELSE compound_statement
                {
			$$ = $2
                }
        ;

iteration_statement:
                FOR conditional_nc compound_statement
                {
			position := astbuild.TokenPositionPush($<line>2, $<column>2)
			$$ = astbuild.IterationExpressions(astbuild.AST,nil, $2, nil, $3)
			astbuild.TokenPositionPop(position)
                }
        |       FOR for_clause_statement for_condition_statement compound_statement
                {			
			$$ = astbuild.IterationExpressions(astbuild.AST,$2, $3, nil, $4)
                }
        |       FOR for_clause_statement for_condition_statement for_post_expression compound_statement
                {
			$$ = astbuild.IterationExpressions(astbuild.AST,$2, $3, $4, $5)
                }
                ;

// A for header holds no bare struct literal outside its init value, so
// `for b {` and `for ...; i = j {` reach the body (skycoin-cx#21).
for_clause_assignment:
                conditional_nc
	|       unary_nc assignment_operator for_clause_assignment
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionAssignmentExpression($1, $2, $3)
			astbuild.TokenPositionPop(position)
                }
                ;

// i++ and i-- are statements, as in Go, so only a post statement holds them.
for_post_expression:
                for_clause_assignment
	|       unary_nc INC_OP
                {
			$$ = astbuild.PostfixExpressionIncDec(astbuild.AST, $1, true)
                }
	|       unary_nc DEC_OP
                {
			$$ = astbuild.PostfixExpressionIncDec(astbuild.AST, $1, false)
                }
	|       assignment_target_list_nc ASSIGN for_assignment_value_list
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionMultipleAssignment($1, $2, $3)
			astbuild.TokenPositionPop(position)
                }
                ;

for_init_assignment:
                conditional_nc
	|       unary_nc assignment_operator assignment_expression
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionAssignmentExpression($1, $2, $3)
			astbuild.TokenPositionPop(position)
                }
                ;

for_init_expression:
                for_init_assignment
	|       assignment_target_list_nc ASSIGN for_assignment_value_list
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionMultipleAssignment($1, $2, $3)
			astbuild.TokenPositionPop(position)
                }
	|       assignment_target_list_nc CASSIGN for_assignment_value_list
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionMultipleAssignment($1, $2, $3)
			astbuild.TokenPositionPop(position)
                }
                ;

for_clause_statement:
                SEMICOLON
                { $$ = nil }
	|       for_init_expression SEMICOLON
                {
			position := astbuild.TokenPositionPush($<line>1, $<column>1)
			$$ = ParserActionExpressionStatement($1)
			astbuild.TokenPositionPop(position)
                }
                ;

// An empty condition is true, as in Go.
for_condition_statement:
                SEMICOLON
                {
			$$ = astbuild.PrimaryExpressionsWrite(astbuild.AST, valuetypes.BOOL, encoder.Serialize(true), false)
                }
	|       for_clause_assignment SEMICOLON
                {
			$$ = ParserActionLoopCondition($1)
                }
                ;

return_expression:
		conditional_expression
		{
			retExprs := astbuild.ReturnExpressions{Expressions: astbuild.AssociateReturnExpressions(astbuild.AST,0, $1)}
			retExprs.Size++
			$$ = retExprs
		}
	|	return_expression COMMA conditional_expression
		{
			$1.Expressions = append($1.Expressions, astbuild.AssociateReturnExpressions(astbuild.AST,$1.Size, $3)...)
			$1.Size++
			$$ = $1
		}
		;

jump_statement: GOTO IDENTIFIER
                {
			pkg, err := astbuild.AST.CurrentPackageGet()
                        if err!=nil{
                                panic(err)
                        }
                        
                        // OBJMODEL: state.CXExpressionMng.CXExpressionAlloc(), phase 4 #346.
                        // Now a constructor call, site S1502.
                        exprCXLine := astbuild.CXLineExpressionCurrentMake(astbuild.AST)
                        // OBJMODEL: state.CXExpressionMng.CXExpressionAlloc(), phase 4 #346.
                        // Now a constructor call, site S1503.
                        expr := ast.AtomicOperatorExpressionMake(astbuild.AST,ast.NativeFunctionOf(astbuild.AST, opcodetable.OpGoto))
                        expressionIdx :=expr.Index
                        astbuild.AST.CXAtomicOps[expressionIdx].Package = ast.CXPackageIndex(pkg.Index)
                        astbuild.AST.CXAtomicOps[expressionIdx].Label = astbuild.AST.CXProgramNameIntern($2)
                        // OBJMODEL: state.CXExpressionMng (manager storage) or []CXExpressionGid, phase 4 #346.
                        // Now a slice of objects, site S1504.
                        $$ = []ast.CXExpression{*exprCXLine,*expr}
			
                }
	|       CONTINUE
		{
			$$ = astbuild.ContinueExpressions(astbuild.AST,)
		}
	|       BREAK
		{
			$$ = astbuild.BreakExpressions(astbuild.AST,)
		}
	|       RETURN
                {
			$$ = astbuild.ReturnExpressionsJmpAdd(astbuild.AST,astbuild.ReturnExpressions{})
                }
	|       RETURN return_expression
                {
			returnExpressions := $2
			returnExpressions.Line, returnExpressions.Column = $<line>1, $<column>1
			$$ = astbuild.ReturnExpressionsJmpAdd(astbuild.AST, returnExpressions)
                }
                ;
%%
