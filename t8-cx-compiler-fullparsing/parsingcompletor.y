/*
This is a machine generated file
parsingcompletor.go is is generated by GOYACC from parsingcompletor.y

build-parser: ## Generate lexer and parser for CX grammar
  	go tool goyacc -o t5-cx-compiler-partialparsing/cxpartialparsing.go t5-cx-compiler-partialparsing/cxpartialparsing.y
	go tool goyacc -o t8-cx-compiler-fullparsing/parsingcompletor.go t8-cx-compiler-fullparsing/parsingcompletor.y

- parsingcompletor.go is output
- t8-cx-compiler-fullparsing/parsingcompletor.y is input
*/
        
	// var astbuild.AST = ProgramMake(CallStackSize, StackSize, HeapSizeInit)
	
	func Parse (lexer *Lexer) int {
		yyErrorVerbose = true
		return yyParse(lexer)
	}
%}

%union{
	i int
	i8 int8
	i16 int16
	i32 int32
	i64 int64
	ui8 uint8
	ui16 uint16
	ui32 uint32
	ui64 uint64
	f32 float32
	f64 float64
	tok string
	bool bool
	string string
	stringA []string
	ints    []int

	line int
	column int
        lineStr string

	// OBJMODEL: CXArgumentGid, the parser value stack lives across Allocs, phase 4 #326.
	// Now a pointer at rest, site S1468.
	argument *ast.CXArgument
	// OBJMODEL: CXArgumentGid, the parser value stack lives across Allocs, phase 4 #326.
	// Now a pointer at rest, site S1469.
	arguments []*ast.CXArgument

	// OBJMODEL: CXExpressionGid, the parser value stack lives across Allocs, phase 4 #346.
	// Now a pointer at rest, site S1470.
	expression *ast.CXExpression
	// OBJMODEL: []CXExpressionGid or CXExpressionGid, phase 5 #347.
	// Now objects held by value, site S1471.
	expressions []ast.CXExpression

	SelectStatement astbuild.SelectStatement
	SelectStatements []astbuild.SelectStatement

	ReturnExpressions astbuild.ReturnExpressions

	// OBJMODEL: []CXExpressionGid or CXExpressionGid, phase 5 #347.
	// Now objects held by value, site S1472.
	arrayArguments [][]ast.CXExpression

	// The elements of an array or slice literal, elided ones not built yet.
	literalElements []astbuild.LiteralElement

    functionIndex ast.CXFunctionGid

    // The names of a global statement, see #486.
    scopeGlobalNames []astbuild.ScopeGlobalName

    // The clauses of an aff literal, see #500.
    affordanceClause astbuild.AffordanceClauseParsed
    affordanceClauses []astbuild.AffordanceClauseParsed
}

%token  <bool>          BOOLEAN_LITERAL
%token  <i8>            BYTE_LITERAL
%token  <i16>           SHORT_LITERAL
%token  <i32>           INT_LITERAL
%token  <i64>           LONG_LITERAL
%token  <ui8>           UNSIGNED_BYTE_LITERAL
%token  <ui16>          UNSIGNED_SHORT_LITERAL
%token  <ui32>          UNSIGNED_INT_LITERAL
%token  <ui64>          UNSIGNED_LONG_LITERAL
%token  <f32>           FLOAT_LITERAL
%token  <f64>           DOUBLE_LITERAL
%token  <tok>           FUNC OP LPAREN RPAREN LBRACE RBRACE LBRACK RBRACK IDENTIFIER
                        VAR GLOBAL COMMA PERIOD COMMENT STRING_LITERAL PACKAGE IF ELSE FOR TYPSTRUCT STRUCT
                        SEMICOLON NEWLINE
                        ASSIGN CASSIGN IMPORT RETURN GOTO GT_OP LT_OP GTEQ_OP LTEQ_OP EQUAL COLON NEW
                        EQUALWORD GTHANWORD LTHANWORD
                        GTHANEQ LTHANEQ UNEQUAL AND OR
                        ADD_OP SUB_OP MUL_OP DIV_OP MOD_OP REF_OP NEG_OP
                        PLUSPLUS MINUSMINUS REMAINDER LEFTSHIFT RIGHTSHIFT EXP
                        NOT
                        BITXOR_OP BITOR_OP BITCLEAR_OP
                        PLUSEQ MINUSEQ MULTEQ DIVEQ REMAINDEREQ EXPEQ
                        LEFTSHIFTEQ RIGHTSHIFTEQ BITANDEQ BITXOREQ BITOREQ

                        DEC_OP INC_OP PTR_OP LEFT_OP RIGHT_OP
                        GE_OP LE_OP EQ_OP NE_OP AND_OP OR_OP
                        ADD_ASSIGN AND_ASSIGN LEFT_ASSIGN MOD_ASSIGN
                        MUL_ASSIGN DIV_ASSIGN OR_ASSIGN RIGHT_ASSIGN
                        SUB_ASSIGN XOR_ASSIGN
                        BOOL F32 F64
                        I8 I16 I32 I64
                        STR
                        UI8 UI16 UI32 UI64
                        UNION ENUM CONST CASE DEFAULT SWITCH BREAK CONTINUE
                        TYPE
                        
                        /* Types */
                        BASICTYPE

                        /* Removers */
                        REM DEF EXPR FIELD CLAUSES OBJECT OBJECTS

                        /* Debugging */
                        DSTACK DPROGRAM DSTATE
                        /* Affordances */
                        AFF TAG INFER VALUE
                        /* Pointers */
                        ADDR

                        yyDefault


%type   <tok>           after_period
