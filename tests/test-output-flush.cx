package main

import "sys/os"
import "sys/string"

// Prints in every way a print lowers and flushes between them. Every output
// mode prints the same (decision D142).
func main() {
	var index i32
	for index = 0; index < 3; index++ {
		printf("line %d %s\n", index, "text")
		i32.print(index)
		f64.print(1.5D)
		bool.print(index == 1)
		os.OutputFlush()
	}
	string.PrintLine("done")
	os.OutputFlush()
	os.OutputFlush()
}
