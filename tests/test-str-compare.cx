// https://github.com/skycoin/skycoin-cx/issues/87

package main

func main() {
	test("b" > "a", true, "b > a")
	test("a" > "b", false, "a > b")
	test("a" > "a", false, "a > a")
	test("a" >= "a", true, "a >= a")
	test("a" >= "b", false, "a >= b")
	test("a" < "b", true, "a < b")
	test("b" < "a", false, "b < a")
	test("a" < "a", false, "a < a")
	test("a" <= "a", true, "a <= a")
	test("b" <= "a", false, "b <= a")

	var x str
	var y str
	x = "apple"
	y = "banana"
	test(x < y, true, "apple < banana")
	test(y > x, true, "banana > apple")
	test(str.lt(x, y), true, "str.lt")
	test(str.gt(x, y), false, "str.gt")
	test(str.gt(x, x), false, "str.gt equal")
	test(str.gteq(x, x), true, "str.gteq")
	test(str.lteq(y, x), false, "str.lteq")
}
